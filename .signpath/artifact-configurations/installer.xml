<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the zip uploaded by .github/workflows/release.yml with the Inno Setup installer
     (built from the already signed executables). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="transom-setup-*-x64.exe" product-name="transom" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
