<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "binaries": the zip uploaded by .github/workflows/release.yml with the three executables. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="transom-app.exe" product-name="transom" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="transom-settings.exe" product-name="transom" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="transom-statusline.exe" product-name="transom" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
